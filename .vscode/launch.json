{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["demos.api:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },
    {
      "name": "Identity",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["demos.identity_service:app", "--port", "8001", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },
    {
      "name": "Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "demos.worker",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },
    {
      "name": "App: run on iOS",
      "type": "node-terminal",
      "request": "launch",
      "command": "LANG=en_US.UTF-8 npx expo run:ios",
      "cwd": "${workspaceFolder}/app"
    },
    {
      "name": "App: attach debugger",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}/app",
      "bundlerHost": "127.0.0.1",
      "bundlerPort": "8081"
    }
  ],
  "compounds": [
    {
      "name": "Backend",
      "configurations": ["Identity", "API", "Worker"]
    },
    {
      "name": "Everything",
      "configurations": ["Identity", "API", "Worker", "App: run on iOS"]
    }
  ]
}
