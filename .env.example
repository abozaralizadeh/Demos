# Copy to .env. Never commit the real file.
DEMOS_DATABASE_URL=postgresql://demos:demos_dev@127.0.0.1:5433/demos
DEMOS_IDENTITY_DATABASE_URL=postgresql://demos:demos_dev@127.0.0.1:5433/demos_identity
DEMOS_IDENTITY_URL=http://127.0.0.1:8001

# Long random strings. setup_service.sh makes these on a VM.
DEMOS_SESSION_SECRET=dev-session-secret
DEMOS_ASSERTION_SECRET=dev-assertion-secret
DEMOS_IDENTITY_PEPPER=dev-identity-pepper
DEMOS_SERVICE_TOKEN=dev-service-token
DEMOS_REVIEW_TOKEN=dev-review-token

# Sample mode labels the app and allows placeholder facts.
DEMOS_SAMPLE_DATA=1
# Dev identity skips the real broker. Must stay off anywhere real.
DEMOS_DEV_IDENTITY=1

DEMOS_LOG_DIR=logs

# Real AI replies. Azure OpenAI is used when these three are set, then Claude if
# ANTHROPIC_API_KEY is, and otherwise the World uses its plain templates.
# Endpoint looks like https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional second deployment, tried only when the first one fails
AZURE_OPENAI_FALLBACK_ENDPOINT=
AZURE_OPENAI_FALLBACK_API_KEY=
AZURE_OPENAI_FALLBACK_DEPLOYMENT=
AI_TIMEOUT_SECONDS=20
# ANTHROPIC_API_KEY=

# Hard caps. Once the day's AI calls or tokens are spent, the World says so politely and
# keeps talking with its templates until tomorrow. Per-address limits answer with a polite 429.
DAILY_REQUEST_CAP=3000
DAILY_TOKEN_BUDGET=300000
RATE_TALK_PER_IP_PER_HOUR=120
RATE_SIGNIN_PER_IP_PER_HOUR=10

# setup_service.sh fills these in on a shared VM: PORT, BASE_PATH, TRUST_PROXY,
# DEMOS_IDENTITY_SOCKET, DEMOS_PG_PASSWORD and DEMOS_PG_PORT.
